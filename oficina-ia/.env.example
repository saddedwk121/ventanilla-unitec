# Copia este archivo como .env y pon tu clave
PORT=8080

# Clave de API del motor de IA (console.anthropic.com → API Keys)
IA_API_KEY=pon-aqui-tu-api-key
# Modelo (opcional)
# IA_MODEL=claude-sonnet-5

# Acceso privado (OBLIGATORIO si la publicas en internet)
# Una cuenta por persona, separadas por comas: usuario:contraseña
APP_USERS=jose:una-clave-larga,ana:otra-clave-larga
